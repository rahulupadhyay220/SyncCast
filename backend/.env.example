# ==============================================================================
# SyncCast Backend Environment Configuration (Template)
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit the active .env file to source control.
# ==============================================================================

# Server Network Configuration
PORT=8080
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/synccast?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/synccast

# Allowed CORS Origins (comma-separated, no wildcards in production)
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging Verbosity: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL=info

# JWT Authentication Secret (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-secure-random-64-character-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Admin Route Authorization Key (for protected administrative APIs)
ADMIN_API_KEY=replace-with-a-secure-random-admin-api-key-here

# Authentication Rate Limiting Configuration
# Strict policy: Max 10 attempts per 10-minute window for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10
